{
  "name": "legalfournier-spain-legal",
  "version": "0.4.0",
  "description": "Spain legal MCP for visa and residency screening, Beckham eligibility, NIE/TIE, nationality, EU family routes, tax-regime comparison, public Legal Fournier tool matching, structured handoff, and explicit-consent contact requests. Agents can also discover written email consultations and 45-minute calls, check live call availability, and use returned secure commerce endpoints after explicit user authorization.",
  "type": "module",
  "license": "MIT",
  "mcpName": "com.legalfournier/spain-legal",
  "homepage": "https://legalfournier.com/en/mcp/spain-legal/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyalerio/legalfournier-spain-legal-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "spain-legal",
    "spain-immigration",
    "spain-tax",
    "beckham-law",
    "digital-nomad-visa",
    "residency",
    "nationality",
    "nie",
    "tie",
    "eu-family"
  ],
  "bin": {
    "spain-legal": "dist/index.js"
  },
  "files": [
    "dist",
    "data/content-index.json",
    "README.md",
    "server.json"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-apps.mjs",
    "check": "npm run build && npm run test",
    "dev": "tsx src/index.ts remote",
    "dev:remote": "tsx src/index.ts remote",
    "dev:stdio": "tsx src/index.ts stdio",
    "generate:registry-auth": "./scripts/generate-http-auth.sh ./.well-known",
    "telemetry:report": "node scripts/telemetry-report.mjs",
    "start": "node dist/index.js remote",
    "start:remote": "node dist/index.js remote",
    "start:stdio": "node dist/index.js stdio",
    "test": "vitest run --maxWorkers=2",
    "content:sync": "python3 scripts/sync-content-index.py",
    "discovery:generate": "LF_MCP_TELEMETRY_ENABLED=0 node scripts/generate-discovery.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "zod": "^4.6.7",
    "@modelcontextprotocol/server": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/ext-apps": "2.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1",
    "@types/express": "^5.0.3",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "esbuild": "0.28.2"
  }
}
